<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_panel" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="光点待办" android:textSize="21sp" android:textStyle="bold" android:textColor="#F4FCFF" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="正在读取待办" android:textSize="11sp" android:textColor="#88ADB9" android:layout_marginTop="3dp" />
        </LinearLayout>
        <TextClock android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:format12Hour="M月d日\nEEEE" android:format24Hour="M月d日\nEEEE" android:textSize="11sp" android:textColor="#B8DBE2" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:background="@drawable/widget_line" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/widget_tasks" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="3dp" android:scrollbars="none" android:clipToPadding="false" />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="留一点空白给生活\n点击 ＋，记下下一件重要的事" android:textColor="#7F9AA9" android:textSize="13sp" android:lineSpacingExtra="6dp" />
    </FrameLayout>
    <LinearLayout android:id="@+id/widget_undo_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="6dp">
        <TextView android:id="@+id/widget_undo_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#91ECF4" android:textSize="10sp" android:layout_marginBottom="2dp" />
        <ListView android:id="@+id/widget_undos" android:layout_width="match_parent" android:layout_height="80dp" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="none" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/widget_manage" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="进入面板  ·  拖拽 / 编辑" android:textColor="#83A9B5" android:textSize="11sp" android:contentDescription="进入待办面板，拖拽排序、长按编辑" />
        <TextView android:id="@+id/widget_add" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="＋" android:textColor="#B5FAFF" android:textSize="23sp" android:background="@drawable/widget_button" android:contentDescription="添加待办" />
    </LinearLayout>
</LinearLayout>
