<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:background="@drawable/widget_row" android:paddingStart="10dp" android:paddingEnd="3dp">
    <LinearLayout android:id="@+id/widget_task_body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/widget_task_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#EFFBFF" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_task_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#7EBBCB" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_task_complete" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="◌" android:textSize="26sp" android:textColor="#81E5EF" />
</LinearLayout>
